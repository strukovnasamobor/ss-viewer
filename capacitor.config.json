{
  "appId": "com.strukovnasamobor.ssviewer_ucenici.twa",
  "appName": "SS Viewer",
  "webDir": "dist",
  "server": {
    "url": "https://raspored.strukovnasamobor.hr",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "path": "android-capacitor"
  },
  "ios": {
    "path": "ios-capacitor",
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true
  }
}